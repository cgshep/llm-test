# Multi-AI Aggregator - API Keys
# Copy this file to .env and fill in your API keys.
# You only need keys for the providers you want to use.

# OpenAI (ChatGPT)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Groq (free tier — https://console.groq.com)
GROQ_API_KEY=

# Ollama (local — no key needed, just run `ollama serve`)
# Set to any non-empty value to enable, e.g. "enabled"
OLLAMA_ENABLED=
# Override the Ollama base URL if not running on localhost
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Aggregation settings
# Which provider to use for aggregating responses: claude, chatgpt, gemini, grok, groq, ollama
AGGREGATOR_PROVIDER=claude
