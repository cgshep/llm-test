# Multi-AI Aggregator - API Keys
# Copy this file to .env and fill in your API keys.
# You only need keys for the providers you want to use.

# OpenAI (ChatGPT)
OPENAI_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# Google (Gemini)
GOOGLE_API_KEY=

# xAI (Grok)
XAI_API_KEY=

# Aggregation settings
# Which provider to use for aggregating responses: claude, chatgpt, gemini, grok
AGGREGATOR_PROVIDER=claude
